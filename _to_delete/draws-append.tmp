

/* ==========================================================================
   Accounting › Draws + Budget (js/project-draws.js) — 2026-11-16
   Same calm style as the Project Overview (.pov-*): white tiles, plain
   rows on the page background, no all-caps headings.
   ========================================================================== */
.dash-tab[hidden] { display: none; }
.dr-panel { display: flex; flex-direction: column; gap: 24px; padding-bottom: 32px; }
.dr-panel > div { display: flex; flex-direction: column; gap: 24px; }
.dr-muted { color: var(--text-soft); font-size: 0.88rem; margin: 0; }
.dr-mt { margin-top: 8px; }
.dr-num { text-align: right; font-weight: 600; font-variant-numeric: tabular-nums; }
.dr-strong { font-weight: 700; }
.dr-faint { color: #9aa6b2; }
.dr-note { margin: 0; padding: 10px 12px; border-radius: var(--radius-sm); background: var(--warning-soft); color: #6b3f0e; font-size: 0.86rem; }

/* callout */
.dr-callout {
  display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap;
  background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md);
  box-shadow: var(--shadow); padding: 20px 24px;
}
.dr-callout-title { margin: 0; font-size: 1.15rem; font-weight: 700; }
.dr-callout-sub { margin: 4px 0 0; color: var(--text-soft); font-size: 0.92rem; }
.dr-callout-form { display: flex; align-items: flex-end; gap: 12px; flex-wrap: wrap; }
.dr-callout-form label { display: flex; flex-direction: column; gap: 4px; font-size: 0.8rem; color: var(--text-soft); font-weight: 600; }
.dr-callout-form input { padding: 9px 10px; border: 1px solid var(--border); border-radius: var(--radius-sm); font-family: inherit; }
.dr-callout .auth-button { margin-top: 0; }

/* tiles */
.dr-tiles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
.dr-tiles--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
.dr-tile-sm { font-size: 1.15rem; }
.dr-grow { flex: 1; }

/* draw list */
.dr-draw-row {
  display: grid; grid-template-columns: 80px minmax(0, 1fr) 140px 130px 16px; gap: 14px; align-items: center;
  width: 100%; padding: 15px 0; border: 0; border-bottom: 1px solid #e1e6eb; background: none;
  font-family: inherit; font-size: 0.95rem; color: var(--text); text-align: left; cursor: pointer;
}
.dr-draw-row:hover strong { color: var(--accent-strong); }
.dr-status { font-size: 0.82rem; font-weight: 700; }
.dr-status--draft { color: var(--accent); }
.dr-status--submitted { color: var(--info); }
.dr-status--funded { color: #1b6b3a; }
.dr-status--opening { color: var(--text-soft); font-weight: 600; }
.dr-group-bar { display: flex; flex-direction: column; gap: 6px; padding: 9px 0; border-bottom: 1px solid #e1e6eb; }
.dr-group-bar > div:first-child { display: flex; justify-content: space-between; font-size: 0.9rem; }
.dr-group-bar span { font-weight: 600; }
.dr-group-bar small { color: var(--text-soft); }

/* editor */
.dr-back, .dr-linkbtn { background: none; border: 0; padding: 4px 0; font-family: inherit; cursor: pointer; }
.dr-back { align-self: flex-start; font-size: 0.9rem; font-weight: 600; color: var(--accent); }
.dr-ed-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; flex-wrap: wrap; }
.dr-big { margin: 2px 0 0; font-size: clamp(2rem, 4vw, 2.6rem); font-weight: 800; letter-spacing: -0.02em; }
.dr-actions { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
.dr-actions--left { justify-content: flex-start; }
.dr-actions .auth-button { margin-top: 0; }
.dr-danger { color: var(--danger) !important; }

.dr-untagged { background: var(--warning-soft); border-radius: var(--radius-md); padding: 14px 18px; display: flex; flex-direction: column; gap: 8px; }
.dr-untagged-head { margin: 0; color: #6b3f0e; font-size: 0.92rem; }
.dr-untagged-row { display: grid; grid-template-columns: minmax(0, 1fr) 110px minmax(200px, 1.2fr) auto; gap: 12px; align-items: center; padding-top: 8px; border-top: 1px solid #f1d9b8; }
.dr-untagged-row strong { display: block; font-size: 0.92rem; }
.dr-untagged-row small { color: #8a5f2c; font-size: 0.8rem; }
.dr-select { padding: 8px 10px; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface); font-family: inherit; font-size: 0.88rem; min-width: 0; }
.dr-small-btn { padding: 9px 14px; }

/* group / line table */
.dr-table { display: flex; flex-direction: column; overflow-x: auto; }
.dr-row {
  display: grid; grid-template-columns: minmax(220px, 1fr) 120px 120px 150px 160px 24px; gap: 14px; align-items: center;
  min-width: 860px; padding: 13px 0; border-bottom: 1px solid #e1e6eb; font-size: 0.92rem; color: var(--text);
}
.dr-row > span:not(:first-child) { text-align: right; font-variant-numeric: tabular-nums; }
.dr-row--head { font-size: 0.8rem; font-weight: 600; color: var(--text-soft); border-bottom-color: var(--border); padding-top: 0; }
.dr-row--group { width: 100%; border-width: 0 0 1px 0; background: none; font-family: inherit; text-align: left; cursor: pointer; font-weight: 600; }
.dr-row--group:hover > span:first-child { color: var(--accent-strong); }
.dr-row--total { font-weight: 800; border-bottom: 0; }
.dr-row--line { padding: 10px 0 10px 18px; font-size: 0.88rem; border-bottom-style: dashed; }
.dr-row--line small { display: block; margin-top: 2px; font-size: 0.78rem; color: var(--accent); }
.dr-lines { padding-bottom: 6px; border-bottom: 1px solid #e1e6eb; }
.dr-more { padding: 8px 0 4px 18px; font-size: 0.8rem; }
.dr-complete { display: flex; align-items: center; gap: 8px; }
.dr-complete .pov-bar { flex: 1; height: 4px; }
.dr-complete small { width: 36px; text-align: right; color: var(--text-soft); }
.dr-input {
  width: 120px; text-align: right; font-family: inherit; font-size: 0.88rem; font-weight: 600;
  padding: 7px 10px; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface); color: var(--text);
}
.dr-input:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
.dr-stored { display: flex; align-items: center; justify-content: flex-end; gap: 6px; margin-top: 6px; font-size: 0.78rem; color: var(--text-soft); }
.dr-stored .dr-input { width: 100px; }
.dr-toggle { display: flex; align-items: center; gap: 8px; margin-top: 12px; font-size: 0.88rem; color: var(--text-soft); }
.dr-row--budget { grid-template-columns: minmax(240px, 1fr) 130px 130px 130px 130px 110px; }
.dr-edit { margin-left: 8px; background: none; border: 0; color: var(--accent); font-family: inherit; font-weight: 600; cursor: pointer; padding: 0; }

/* import popup */
.dr-popup { max-width: 640px; }
.dr-import-groups { display: flex; flex-direction: column; max-height: 260px; overflow-y: auto; margin: 8px 0; }
.dr-import-groups div { display: flex; justify-content: space-between; gap: 12px; padding: 7px 0; border-bottom: 1px solid #e1e6eb; font-size: 0.88rem; }
.dr-import-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }

@media (max-width: 820px) {
  .dr-tiles, .dr-tiles--4 { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .dr-tiles--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .dr-draw-row { grid-template-columns: 56px minmax(0, 1fr) auto 16px; }
  .dr-draw-row .dr-muted { display: none; }
  .dr-untagged-row { grid-template-columns: minmax(0, 1fr) auto; }
  .dr-untagged-row .dr-select { grid-column: 1 / -1; }
  .dr-import-grid { grid-template-columns: minmax(0, 1fr); }
  .dr-callout { padding: 16px; }
}

/* invoice form — budget line picker (js/project-invoices.js) */
.inv-budget .inv-label small { font-weight: 500; color: var(--text-soft); }
.inv-chips { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-top: 8px; }
.inv-chips small { color: var(--text-soft); font-size: 0.78rem; }
.inv-chip { border: 1px solid #c9d9e6; background: var(--surface); color: var(--accent-strong); border-radius: 999px; padding: 5px 10px; font-family: inherit; font-size: 0.78rem; font-weight: 600; cursor: pointer; }
.inv-check--small { margin-top: 8px; }
.inv-line-group { margin: 12px 0 4px; font-size: 0.78rem; font-weight: 700; color: var(--text-soft); }
