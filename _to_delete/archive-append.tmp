
/* Project Overview — archived 1+ year → offload banner (js/project-archive.js), 2026-11-17 */
.pov-archive {
  display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap;
  padding: 16px 20px; border-radius: var(--radius-md);
  background: var(--warning-soft); border: 1px solid #f1d9b8; color: #6b3f0e;
}
.pov-archive[hidden] { display: none; }
.pov-archive strong { display: block; font-size: 1rem; }
.pov-archive p { margin: 4px 0 0; font-size: 0.9rem; }
.pov-archive .auth-button { margin-top: 0; }
.pov-archive-btn { background: none; border: 0; cursor: pointer; font-family: inherit; color: #6b3f0e; }
#povArchiveProgress { min-height: 1.4em; }
