/* ---------- Phone: frosted glass More sheet ----------
   Same smoky frosted glass as the tab bar. */
@media (max-width: 768px) {
  .mobile-sheet {
    background: rgba(28, 36, 44, 0.56);
    -webkit-backdrop-filter: blur(30px) saturate(160%);
    backdrop-filter: blur(30px) saturate(160%);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-bottom: 0;
    box-shadow:
      0 -12px 40px rgba(7, 20, 30, 0.25),
      inset 0 1px 0 rgba(255, 255, 255, 0.3);
    color: #fff;
  }

  .mobile-sheet-handle span { background: rgba(255, 255, 255, 0.45); }

  .mobile-sheet-head,
  .mobile-sheet-foot { border-color: rgba(255, 255, 255, 0.12); }
  .mobile-sheet-divider { background: rgba(255, 255, 255, 0.12); }

  .mobile-sheet-name { color: #fff; }
  .mobile-sheet-sub { color: rgba(255, 255, 255, 0.65); }
  .mobile-sheet-section { color: rgba(255, 255, 255, 0.55); }

  .mobile-sheet-avatar {
    background: rgba(255, 255, 255, 0.18);
    border: 1px solid rgba(255, 255, 255, 0.3);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35);
  }

  .mobile-sheet-row,
  .mobile-sheet-row.is-active { color: #fff; }
  .mobile-sheet-row:active { background: rgba(255, 255, 255, 0.1); }

  /* Current page: a glass pill, same as the active tab. */
  .mobile-sheet-row.is-active {
    background: rgba(255, 255, 255, 0.14);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.22), inset 0 1px 0 rgba(255, 255, 255, 0.28);
  }

  .mobile-sheet-row-icon,
  .mobile-sheet-row--muted .mobile-sheet-row-icon {
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.16);
  }

  .mobile-sheet-chevron { color: rgba(255, 255, 255, 0.45); }

  .mobile-sheet-btn {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
    color: #fff;
  }
}
